          }
        },
        {
          "name": "TC-SHP-03: Cập nhật trạng thái Shipment -> SHIPPING (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-SHP-03: Trạng thái Shipment cập nhật sang SHIPPING', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('SHIPPING');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staff_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPING\"\n}"
            },
            "url": "{{baseUrl}}/api/shipments/{{test_shipid}}/status"
          }
        },
        {
          "name": "TC-SHP-04: Cập nhật Shipment không tồn tại (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-SHP-04: Cập nhật shipid không tồn tại trả 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staff_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\"\n}"
            },
            "url": "{{baseUrl}}/api/shipments/999999/status"
          }
        },
        {
          "name": "TC-SHP-05 (Bước 1): Gửi trùng OrderCreated Event lần 2 vào Kafka",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-SHP-05a: Đã gửi lại cùng OrderCreated event với cùng oid vào Kafka', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payload\": {\n    \"eventType\": \"OrderCreated\",\n    \"data\": {\n      \"oid\": {{test_oid}},\n      \"uid\": {{test_uid}}\n    }\n  }\n}"
            },
            "url": "{{baseUrl}}/api/orders/test-kafka-event"
          }
        },
        {
          "name": "TC-SHP-05 (Bước 2): Xác minh không tạo Shipment trùng cho cùng oid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-SHP-05b: Không có Shipment trùng cho cùng oid (Idempotent Consumer)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var targetOid = Number(pm.collectionVariables.get('test_oid'));",
                  "    var matches = pm.response.json().items.filter(function(s) { return s.oid === targetOid; });",
                  "    pm.expect(matches.length).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{baseUrl}}/api/shipments"
          }
        }
      ]
    }
  ]
