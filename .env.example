# Shared JWT Configuration
JWT_SECRET=ecommerce-mvp-super-secret-jwt-key-2026
JWT_EXPIRES_IN=3600

# API Gateway & Redis
GATEWAY_PORT=3000
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=100
CACHE_TTL_SEC=60

# gRPC Service Addresses (Local Default)
AUTH_SERVICE_URL=localhost:50051
CUSTOMER_SERVICE_URL=localhost:50052
PRODUCT_SERVICE_URL=localhost:50053
ORDER_SERVICE_URL=localhost:50054
SHIPMENT_SERVICE_URL=localhost:50055

# Databases (Database-per-Service)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auth_db
CUSTOMER_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/customer_db
ORDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/order_db
PRODUCT_MONGO_URI=mongodb://localhost:27018/product_db
SHIPMENT_MONGO_URI=mongodb://localhost:27019/shipment_db

# Apache Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_ORDER_TOPIC=order-created

